+  std::string fromws(const WCHAR *ws) {
+    if (!ws) return "";
+    std::string result;
+    for (const WCHAR* p = ws; *p; ++p) {
+      uint32_t c = uint16_t(*p);
+      if (c < 0x80) {
+        result.push_back(char(c));
+      } else if (c < 0x800) {
+        result.push_back(char(0xC0 | (c >> 6)));
+        result.push_back(char(0x80 | (c & 0x3F)));
+      } else {
+        result.push_back(char(0xE0 | (c >> 12)));
+        result.push_back(char(0x80 | ((c >> 6) & 0x3F)));
+        result.push_back(char(0x80 | (c & 0x3F)));
+      }
+    }
+    return result;
+  }
+
+  void tows(const char* mbs, WCHAR* wcs, size_t wcsLen) {
+    if (!wcs || !wcsLen) return;
+    size_t i = 0;
+    if (mbs) {
+      while (mbs[i] && i + 1 < wcsLen) {
+        wcs[i] = WCHAR(uint8_t(mbs[i]));
+        ++i;
+      }
+    }
+    wcs[i] = 0;
+  }
+
+  std::wstring tows(const char* mbs) {
+    std::wstring result;
+    if (!mbs) return result;
+    for (const char* p = mbs; *p; ++p)
+      result.push_back(wchar_t(uint8_t(*p)));
+    return result;
+  }
+#endif
 
 }
