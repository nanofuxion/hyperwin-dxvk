+  bool D3D9Query::QueryGateOn() {
+    static const bool on = []() {
+#ifdef __ANDROID__
+      char prop[PROP_VALUE_MAX] = {};
+      if (__system_property_get("debug.hwd3d.qgate", prop) > 0) return prop[0] != '0';
+#endif
+      const char* v = std::getenv("HWD3D_QUERY_GATE");
+      return !(v && v[0] == '0');
+    }();
+    static const bool told = [](bool g) { Logger::info(g ? "D3D9 query gate: on (a result is read once the submission holding its end has finished)" : "D3D9 query gate: off"); return true; }(on);
+    (void)told;
+    return on;
+  }
+
