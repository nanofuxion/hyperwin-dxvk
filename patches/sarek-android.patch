@@ -7888,4 +7888,139 @@ namespace dxvk {
     return m_csChunk->empty() ? m_csSeqNum : m_csSeqNum + 1;
   }
 
+  HRESULT D3D9DeviceEx::BlitToVkImage(
+          IDirect3DSurface9* pSourceSurface,
+          VkImage            dstVkImage,
+          VkFormat           dstFormat,
+          uint32_t           dstWidth,
+          uint32_t           dstHeight) {
+    D3D9DeviceLock lock = LockDevice();
+
+    D3D9Surface* src = static_cast<D3D9Surface*>(pSourceSurface);
+    if (unlikely(src == nullptr || dstVkImage == VK_NULL_HANDLE || !dstWidth || !dstHeight))
+      return D3DERR_INVALIDCALL;
+
+    D3D9CommonTexture* srcTextureInfo = src->GetCommonTexture();
+    if (unlikely(srcTextureInfo == nullptr))
+      return D3DERR_INVALIDCALL;
+
+    Rc<DxvkImage> srcImage = srcTextureInfo->GetImage();
+    if (unlikely(srcImage == nullptr))
+      return D3DERR_INVALIDCALL;
+
+    Rc<DxvkImage> dstImage;
+    for (auto& e : m_scanoutImages) {
+      if (e.vkImage == dstVkImage && e.format == dstFormat && e.width == dstWidth && e.height == dstHeight) {
+        dstImage = e.image;
+        break;
+      }
+    }
+    if (dstImage == nullptr) {
+      DxvkImageCreateInfo imageInfo = {};
+      imageInfo.type        = VK_IMAGE_TYPE_2D;
+      imageInfo.format      = dstFormat;
+      imageInfo.flags       = 0;
+      imageInfo.sampleCount = VK_SAMPLE_COUNT_1_BIT;
+      imageInfo.extent      = { dstWidth, dstHeight, 1u };
+      imageInfo.numLayers   = 1;
+      imageInfo.mipLevels   = 1;
+      imageInfo.usage       = VK_IMAGE_USAGE_TRANSFER_SRC_BIT
+                            | VK_IMAGE_USAGE_TRANSFER_DST_BIT
+                            | VK_IMAGE_USAGE_SAMPLED_BIT
+                            | VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+      imageInfo.stages      = VK_PIPELINE_STAGE_TRANSFER_BIT
+                            | VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT
+                            | VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT;
+      imageInfo.access      = VK_ACCESS_TRANSFER_READ_BIT
+                            | VK_ACCESS_TRANSFER_WRITE_BIT
+                            | VK_ACCESS_COLOR_ATTACHMENT_READ_BIT
+                            | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT
+                            | VK_ACCESS_SHADER_READ_BIT;
+      imageInfo.tiling        = VK_IMAGE_TILING_OPTIMAL;
+      // Kept in GENERAL, as the D3D11 path keeps its imported images. Clearing it first (initImage)
+      // and keeping it SHADER_READ_ONLY lost the device on Mali.
+      imageInfo.layout        = VK_IMAGE_LAYOUT_GENERAL;
+      imageInfo.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+      dstImage = m_dxvkDevice->createImageFromVkImage(imageInfo, dstVkImage);
+      auto& slot = m_scanoutImages[m_scanoutImageNext++ & 3u];
+      slot = { dstVkImage, dstFormat, dstWidth, dstHeight, dstImage };
+    }
+
+    VkExtent3D srcExtent = srcTextureInfo->GetExtentMip(src->GetMipLevel());
+    VkImageSubresource srcSub = srcTextureInfo->GetSubresourceFromIndex(VK_IMAGE_ASPECT_COLOR_BIT, src->GetSubresource());
+    VkImageSubresourceLayers srcLayers = { srcSub.aspectMask, srcSub.mipLevel, srcSub.arrayLayer, 1u };
+    VkImageSubresourceLayers dstLayers = { VK_IMAGE_ASPECT_COLOR_BIT, 0u, 0u, 1u };
+
+    if (srcImage->info().sampleCount != VK_SAMPLE_COUNT_1_BIT) {
+      auto resolveSrc = srcTextureInfo->GetResolveImage();
+      VkImageResolve region = {};
+      region.srcSubresource = srcLayers;
+      region.srcOffset      = { 0, 0, 0 };
+      region.dstSubresource = srcLayers;
+      region.dstOffset      = { 0, 0, 0 };
+      region.extent         = srcExtent;
+      EmitCs([
+        cDstImage = resolveSrc,
+        cSrcImage = srcImage,
+        cRegion   = region
+      ] (DxvkContext* ctx) {
+        ctx->resolveImage(cDstImage, cSrcImage, cRegion, VK_FORMAT_UNDEFINED);
+      });
+      srcImage = resolveSrc;
+    }
+
+    // Same format and size: a plain copy. A blit goes through a render pass with a shader, and that
+    // into the phone's buffer (an imported AHardwareBuffer) lost the device on Mali.
+    if (srcImage->info().format == dstFormat && srcExtent.width == dstWidth && srcExtent.height == dstHeight) {
+      EmitCs([
+        cDstImage = dstImage,
+        cSrcImage = srcImage,
+        cDstLayers = dstLayers,
+        cSrcLayers = srcLayers,
+        cExtent = VkExtent3D { dstWidth, dstHeight, 1u }
+      ] (DxvkContext* ctx) {
+        ctx->copyImage(cDstImage, cDstLayers, VkOffset3D { 0, 0, 0 },
+                       cSrcImage, cSrcLayers, VkOffset3D { 0, 0, 0 }, cExtent);
+      });
+      Flush();
+      SynchronizeCsThread(DxvkCsThread::SynchronizeAll);
+      return D3D_OK;
+    }
+
+    VkImageBlit blitInfo = {};
+    blitInfo.srcSubresource = srcLayers;
+    blitInfo.srcOffsets[0]  = { 0, 0, 0 };
+    blitInfo.srcOffsets[1]  = { int32_t(srcExtent.width), int32_t(srcExtent.height), 1 };
+    blitInfo.dstSubresource = dstLayers;
+    blitInfo.dstOffsets[0]  = { 0, 0, 0 };
+    blitInfo.dstOffsets[1]  = { int32_t(dstWidth), int32_t(dstHeight), 1 };
+
+    VkComponentMapping dstMap = {
+      VK_COMPONENT_SWIZZLE_IDENTITY,
+      VK_COMPONENT_SWIZZLE_IDENTITY,
+      VK_COMPONENT_SWIZZLE_IDENTITY,
+      VK_COMPONENT_SWIZZLE_IDENTITY,
+    };
+
+    EmitCs([
+      cDstImage = dstImage,
+      cDstMap   = dstMap,
+      cSrcImage = srcImage,
+      cSrcMap   = srcTextureInfo->GetMapping().Swizzle,
+      cBlitInfo = blitInfo
+    ] (DxvkContext* ctx) {
+      ctx->blitImage(
+        cDstImage,
+        cDstMap,
+        cSrcImage,
+        cSrcMap,
+        cBlitInfo,
+        VK_FILTER_NEAREST);
+    });
+
+    Flush();
+    SynchronizeCsThread(DxvkCsThread::SynchronizeAll);
+    return D3D_OK;
+  }
+
 }
