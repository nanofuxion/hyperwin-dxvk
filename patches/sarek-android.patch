+  HRESULT D3D11DeviceContext::HwBlitSwapRB(ID3D11Resource* pDst, ID3D11Resource* pSrc, const D3D11_BOX* pBox) {
+    D3D10DeviceLock lock = LockContext();
+    auto dst = GetCommonTexture(pDst);
+    auto src = GetCommonTexture(pSrc);
+    if (!dst || !src || dst->GetMapMode() == D3D11_COMMON_TEXTURE_MAP_MODE_BUFFER ||
+        src->GetMapMode() == D3D11_COMMON_TEXTURE_MAP_MODE_BUFFER)
+      return E_INVALIDARG;
+    VkImageSubresourceLayers layers = { VK_IMAGE_ASPECT_COLOR_BIT, 0u, 0u, 1u };
+    VkExtent3D ext = src->GetImage()->info().extent;
+    VkImageBlit blit = {};
+    blit.srcSubresource = layers;
+    blit.dstSubresource = layers;
+    int32_t l = pBox ? int32_t(pBox->left) : 0, t = pBox ? int32_t(pBox->top) : 0;
+    int32_t r = pBox ? int32_t(pBox->right) : int32_t(ext.width), b = pBox ? int32_t(pBox->bottom) : int32_t(ext.height);
+    blit.srcOffsets[0] = blit.dstOffsets[0] = { l, t, 0 };
+    blit.srcOffsets[1] = blit.dstOffsets[1] = { r, b, 1 };
+    VkComponentMapping id = { VK_COMPONENT_SWIZZLE_IDENTITY, VK_COMPONENT_SWIZZLE_IDENTITY,
+                              VK_COMPONENT_SWIZZLE_IDENTITY, VK_COMPONENT_SWIZZLE_IDENTITY };
+    // A blit converts between the two formats by component, so colours stay colours whatever the byte order.
+    EmitCs([cDst = dst->GetImage(), cSrc = src->GetImage(), cBlit = blit, id] (DxvkContext* ctx) {
+      ctx->blitImage(cDst, id, cSrc, id, cBlit, VK_FILTER_NEAREST);
+    });
+    return S_OK;
+  }
+
