   }
 
+  DLLEXPORT void hwd3d9_get_vk_handles(
+          IDirect3DDevice9Ex* pDevice,
+          VkInstance*         pInstance,
+          VkPhysicalDevice*   pPhysDev,
+          VkDevice*           pVkDevice) {
+    if (!pDevice) return;
+    auto* dev = static_cast<dxvk::D3D9DeviceEx*>(pDevice);
+    auto dxvkDev = dev->GetDXVKDevice();
+    if (pInstance) *pInstance = dxvkDev->instance()->handle();
+    if (pPhysDev)  *pPhysDev  = dxvkDev->adapter()->handle();
+    if (pVkDevice) *pVkDevice = dxvkDev->handle();
+  }
+
+  DLLEXPORT HRESULT hwd3d9_blit_to_vkimage(
+          IDirect3DDevice9Ex* pDevice,
+          IDirect3DSurface9*  pSurface,
+          VkImage             dstVkImage,
+          uint32_t            dstFormat,
+          uint32_t            dstWidth,
+          uint32_t            dstHeight) {
+    if (!pDevice || !pSurface) return D3DERR_INVALIDCALL;
+    auto* dev = static_cast<dxvk::D3D9DeviceEx*>(pDevice);
+    return dev->BlitToVkImage(pSurface, dstVkImage, VkFormat(dstFormat), dstWidth, dstHeight);
+  }
+
 }
